# PrudenTia API — environment configuration
#
# Copy to `.env` and fill in. NOTHING in this file is a real secret.
#
# IMPORTANT: these names are the ones `src/_services/_constants.ts` actually reads.
# The template estate's .env.example had drifted from its own code (documenting
# DB_HOST/JWT_SECRET while the code read DATABASE_HOST/AUTH_JWT_KEY), which meant a
# fresh clone configured from it could not connect. Keep this file generated from
# _constants.ts, not written from memory. CLAUDE.md §6.

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Azure App Service supplies PORT. Do not hard-code it in deployment.
PORT=8080
# Separate from NODE_ENV, and deliberately so. IS_PRODUCTION=true turns on TLS to the
# database AND strips the body from 500 responses. Setting one without the other leaves
# the app silently half-configured — this has bitten the template estate before.
IS_PRODUCTION=false

# ─── Database: read-write connection ──────────────────────────────────────────
# Migrations, seeds, authentication, the audit log. NEVER generated SQL.
# This role must NOT be a superuser: a superuser bypasses the privilege separation that
# ADR-03's entire defence-in-depth argument rests on, and the Phase 7 defence tests
# would pass vacuously against it.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=prudentia
DATABASE_USER=prudentia_app
# QUOTE any password containing `#`. dotenv treats an unquoted `#` as the start of a
# comment, so `secret#2026` silently becomes `secret` and you get an authentication
# failure whose message says nothing about truncation.
DATABASE_PASSWORD=""

# ─── Database: SELECT-only connection ─────────────────────────────────────────
# Used EXCLUSIVELY for validated, generated SQL (CLAUDE.md §4 rule 4, ADR-03, NFR-02).
# Holds SELECT on the 8 analytics tables and nothing at all on users or query_log.
# Startup asserts this and REFUSES TO BOOT if a write succeeds through it (DV-9).
DATABASE_RO_USER=prudentia_ro
DATABASE_RO_PASSWORD=

# TLS to the database. Required by Azure Database for PostgreSQL; off locally.
SSL_MODE_ENV=false

# ─── Authentication ───────────────────────────────────────────────────────────
# Signing key for session tokens. Generate with: openssl rand -base64 48
AUTH_JWT_KEY=
# NFR-06: tokens expire within 60 minutes of issue.
JWT_EXPIRY_MINUTES=60

# ─── Query pipeline ceilings ──────────────────────────────────────────────────
# FR-13: row ceiling, applied by WRAPPING the validated statement and again by slicing
# the result in the executor — two independent guards.
MAX_RESULT_ROWS=1000
# NFR-11: no executed statement runs longer than this. Set on the read-only ROLE in a
# migration as well, so it holds even if the application forgets to ask.
STATEMENT_TIMEOUT_MS=10000
# FR-08: maximum question length, applied to the TRIMMED value.
MAX_QUESTION_LENGTH=500
# FR-18: per-user rate limit on the query endpoint, requests per minute.
QUERY_RATE_LIMIT_PER_MINUTE=20

# ─── LLM provider ─────────────────────────────────────────────────────────────
# `claude` | `openai` | `azure-openai` | `stub`.
#
# Every provider is asked for the SAME two tools with the same descriptions and schemas,
# and every response is interpreted by the same function (src/llm/toolContract.ts). So the
# provider is the only variable: the gate, the executor, the audit trail and the interface
# neither know nor can be affected by which vendor answered. That is also what makes a
# model comparison meaningful — the prompt does not change when the model does.
#
# The stub is deterministic, needs no network and no key, and is the graceful-degradation
# path of NFR-12 — not merely a test double. Any selection whose credentials are missing
# falls back to it WITH A WARNING, and the live provider is printed at boot. A build
# quietly serving fixtures while you believe it is talking to Azure is the failure that
# warning exists to prevent.
LLM_PROVIDER=stub

# The model, for every provider that names one in the request body.
# Azure is the exception — it routes by DEPLOYMENT in the URL; see AZURE_OPENAI_DEPLOYMENT.
LLM_MODEL=claude-opus-5

# Sampling temperature. 0 is the default: NL→SQL wants the most probable statement, not a
# varied one. LEAVE IT EMPTY to omit the field entirely — reasoning models (o-series and
# newer families) reject `temperature` with a 400, so an unconditional value would make
# this build silently incompatible with them.
LLM_TEMPERATURE=0

# Reasoning effort for Claude: low | medium | high | xhigh | max. EMPTY BY DEFAULT, and
# leave it empty unless the configured model is known to support it.
# `output_config` exists only on the newer Claude families; sending it to an older model
# (claude-sonnet-4-5, for instance) returns a 400 and every question is reported as an
# outage. Same rule as LLM_TEMPERATURE above — a capability the newest model has is not a
# capability to assume.
LLM_EFFORT=

# ─── claude ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── openai, and anything speaking the same wire format ──────────────────────
# Leave OPENAI_BASE_URL unset for OpenAI itself. Set it to point at a self-hosted
# OpenAI-compatible server instead — vLLM, Ollama's OpenAI shim, LM Studio, a gateway.
# A custom base URL is allowed to be unauthenticated; api.openai.com is not.
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:8000/v1

# ─── azure openai ─────────────────────────────────────────────────────────────
# The DEPLOYMENT name is chosen by whoever deployed the model and need not match any
# published model id — which is why it is configured here rather than in LLM_MODEL.
# API version 2024-06-01 or later is required: `tool_choice: required` is what makes a
# prose reply structurally impossible, and it does not exist on earlier versions.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins. Empty disables cross-origin access entirely.
# No trailing slash — a trailing slash never matches.
#
# All three Vite ports are listed because Vite does NOT fail when 5173 is taken — it
# walks up to 5174, 5175, ... and prints the port it settled on. If another project is
# already running, the app comes up on a port the API has never heard of and every call
# fails CORS while the interface looks fine. Listing the fallbacks costs nothing (they
# are localhost dev origins) and removes a confusing failure. Production sets exactly
# one origin: the Static Web Apps hostname.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# TH-08 — per-IP limit on the login endpoint.
LOGIN_RATE_LIMIT_PER_MINUTE=10
