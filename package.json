{
	"name": "prudentia-api",
	"version": "1.0.0",
	"author": "Henry Asante",
	"private": true,
	"license": "UNLICENSED",
	"main": "dist/index.js",
	"scripts": {
		"start": "node dist/index.js",
		"clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "npm run clean && tsc -p tsconfig.build.json",
		"dev": "tsnd --respawn --rs --watch .env src/index.ts",
		"prod": "npm run build && cd dist && npm start",
		"typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json",
		"typecheck:strict": "node scripts/typecheck-strict.js",
		"lint": "node node_modules/eslint/bin/eslint.js src",
		"run_test": "cross-env NODE_ENV=test jest --runInBand",
		"test:unit": "npm run run_test -- --config ./jest.config.ts",
		"test:e2e": "npm run run_test -- --config ./jest-e2e.config.ts --forceExit",
		"test": "npm run test:unit && npm run test:e2e",
		"db:migrate": "knex migrate:latest",
		"db:rollback": "knex migrate:rollback",
		"db:seed": "knex seed:run",
		"db:reset": "npm run db:rollback -- --all && npm run db:migrate && npm run db:seed",
		"verify:signals": "ts-node scripts/verify-signals.ts",
		"verify": "npm run lint && npm run typecheck:strict && npm run test:unit && npm run test:e2e",
		"smoke:prod": "node scripts/prod-boot-smoke.js"
	},
	"engines": {
		"node": ">=20.0.0",
		"npm": ">=9.0.0"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/express": "4.17.21",
		"@types/jest": "^29.5.11",
		"@types/lodash": "^4.14.202",
		"@types/node": "^20.10.4",
		"@types/supertest": "^2.0.11",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"cross-env": "^7.0.3",
		"eslint-plugin-rulesdir": "^0.2.2",
		"jest": "^29.7.0",
		"supertest": "^6.1.3",
		"ts-jest": "^29.1.1",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.116.0",
		"cors": "^2.8.5",
		"date-fns": "^2.30.0",
		"dotenv": "^16.3.1",
		"eslint": "^9.37.0",
		"express": "^4.18.2",
		"express-rate-limit": "^8.2.1",
		"helmet": "^8.1.0",
		"knex": "3.1.0",
		"libpg-query": "17.7.4",
		"lodash": "^4.17.19",
		"module-alias": "^2.2.3",
		"njwt": "^2.0.0",
		"pg": "^8.16.3",
		"zod": "^4.4.3"
	}
}
